# Configuration names for the web app. Put actual values in web/.env.local
# (or web/.env), not here or in the repository root.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional fallback for OpenAI quota/rate limits (HTTP 429); requires GEMINI_API_KEY.
# AI_FALLBACK_PROVIDER=gemini
# Optional alternative: set AI_PROVIDER=gemini and provide its key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
SERPER_API_KEY=
