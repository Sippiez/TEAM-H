# Configuration names for the web app. Put actual values in web/.env.local
# (or web/.env), not here or in the repository root.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional alternative: set AI_PROVIDER=openai and provide its key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Optional fallback when AI_PROVIDER=openai hits HTTP 429; requires GEMINI_API_KEY.
# AI_FALLBACK_PROVIDER=gemini
SERPER_API_KEY=
