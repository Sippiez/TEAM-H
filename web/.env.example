# Server-side only. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=

# Change the deployed model without editing application code.
GEMINI_MODEL=gemini-3.1-flash-lite

# Official lookup checks pages directly first, then uses Google Search grounding
# with GEMINI_API_KEY only if direct lookup fails. Google needs grounding quota.
# Mapped service pages and recognized forms do not need a Brave key.
# Optional: enable broader direct-page discovery through Brave before Google.
BRAVE_SEARCH_API_KEY=