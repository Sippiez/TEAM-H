# Server-side only. Never prefix this with NEXT_PUBLIC_.
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Change the deployed model without editing application code.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional alternative: set AI_PROVIDER=openai and provide its key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional fallback when AI_PROVIDER=openai hits HTTP 429; requires GEMINI_API_KEY.
# AI_FALLBACK_PROVIDER=gemini

# Server-side web search for discovery and failed mapped-page lookups.
# Mapped pages and recognized forms are checked directly before spending credits.
# The selected AI provider generates answers; built-in web search is not used.
SERPER_API_KEY=